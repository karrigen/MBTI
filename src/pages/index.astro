---
import questions from '../data/quiz.json';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>魔法学院分院帽测试</title>
    <style>
      body { font-family: sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
      .hidden { display: none; }
      button { display: block; width: 100%; margin: 10px 0; padding: 12px; cursor: pointer; }
    </style>
  </head>
  <body>
    <!-- 1. 首页欢迎区 -->
    <div id="start-screen">
      <h1>🧙‍♂️ 魔法学院分院帽测试</h1>
      <p>回答 20 道小问题，探索你的魔法潜能！</p>
      <button id="start-btn">开始测试</button>
    </div>

    <!-- 2. 答题区 -->
    <div id="quiz-screen" class="hidden">
      <h3 id="progress-text"></h3>
      <h2 id="question-text"></h2>
      <div id="options-container"></div>
    </div>

    <!-- 3. 结果展示区 -->
    <div id="result-screen" class="hidden">
      <h2>🎉 你的分院结果是：<span id="result-mbti"></span></h2>
      <button onclick="location.reload()">重新测试</button>
    </div>

    <!-- 脚本：控制答题流程与计分 -->
    <script define:vars={{ questions }}>
      let currentIndex = 0;
      const userAnswers = [];

      const startBtn = document.getElementById('start-btn');
      const startScreen = document.getElementById('start-screen');
      const quizScreen = document.getElementById('quiz-screen');
      const resultScreen = document.getElementById('result-screen');

      startBtn.addEventListener('click', () => {
        startScreen.classList.add('hidden');
        quizScreen.classList.remove('hidden');
        showQuestion();
      });

      function showQuestion() {
        const q = questions[currentIndex];
        document.getElementById('progress-text').innerText = `第 ${currentIndex + 1} / ${questions.length} 题`;
        document.getElementById('question-text').innerText = q.question;

        const container = document.getElementById('options-container');
        container.innerHTML = '';

        q.options.forEach(opt => {
          const btn = document.createElement('button');
          btn.innerText = opt.text;
          btn.onclick = () => selectOption(opt.dimension);
          container.appendChild(btn);
        });
      }

      function selectOption(dim) {
        userAnswers.push(dim);
        currentIndex++;

        if (currentIndex < questions.length) {
          showQuestion();
        } else {
          showResult();
        }
      }

      function showResult() {
        quizScreen.classList.add('hidden');
        resultScreen.classList.remove('hidden');

        // 计算得分
        const counts = { E:0, I:0, S:0, N:0, T:0, F:0, J:0, P:0 };
        userAnswers.forEach(d => counts[d]++);

        const mbti = [
          counts.E >= counts.I ? 'E' : 'I',
          counts.S >= counts.N ? 'S' : 'N',
          counts.T >= counts.F ? 'T' : 'F',
          counts.J >= counts.P ? 'J' : 'P'
        ].join('');

        document.getElementById('result-mbti').innerText = mbti;
      }
    </script>
  </body>
</html>
