---
import questions from '../data/quiz.json';
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>魔法学院分院帽测试</title>
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #ffffff;
        color: #1e293b;
        max-width: 600px;
        margin: 0 auto;
        padding: 24px 16px;
      }
      .hidden { display: none; }
      .card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      }
      h1 {
        color: #d97706;
        font-size: 1.9rem;
        text-align: center;
        margin-bottom: 14px;
        line-height: 1.3;
      }
      p {
        color: #475569;
        line-height: 1.7;
        text-align: center;
        font-size: 1.15rem;
      }
      .progress {
        color: #0284c7;
        font-size: 1.05rem;
        margin-bottom: 10px;
        font-weight: bold;
      }
      .question {
        font-size: 1.4rem;
        color: #0f172a;
        margin-bottom: 20px;
        text-align: left;
        line-height: 1.5;
      }
      .option-btn {
        display: block;
        width: 100%;
        background-color: #ffffff;
        color: #1e293b;
        border: 2px solid #cbd5e1;
        border-radius: 14px;
        padding: 20px 18px;
        margin-bottom: 20px;
        font-size: 1.35rem;
        line-height: 1.6;
        text-align: left;
        cursor: pointer;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .option-btn:last-child {
        margin-bottom: 0;
      }
      .option-btn .option-label {
        display: inline-block;
        font-weight: bold;
        color: #0284c7;
        margin-right: 8px;
      }
      .option-btn:hover,
      .option-btn:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
        outline: none;
      }
      .option-btn:active {
        border-color: #2563eb;
      }

      /* 手机屏幕进一步放大字号、增加点击区域 */
      @media (max-width: 480px) {
        body { padding: 16px 12px; }
        h1 { font-size: 1.6rem; }
        p { font-size: 1.1rem; }
        .question { font-size: 1.3rem; }
        .option-btn { font-size: 1.15rem; padding: 20px 16px; }
        .start-btn { font-size: 1.25rem; padding: 20px; }
      }
    </style>
  </head>
  <body>
    <!-- 1. 首页欢迎屏 -->
    <div id="start-screen" class="card">
      <h1>🧙‍♂️ 魔法学院分院帽测试</h1>
      <p>回答 20 道简单的小问题，探索隐藏在你心中的魔法学院属性与神奇天赋！</p>
      <button id="start-btn" class="start-btn">开始测试</button>
    </div>

    <!-- 2. 答题屏 -->
    <div id="quiz-screen" class="card hidden">
      <div id="progress-text" class="progress"></div>
      <div id="question-text" class="question"></div>
      <div id="options-container"></div>
    </div>

    <script define:vars={{ questions }}>
      let currentIndex = 0;
      const userAnswers = [];

      const startBtn = document.getElementById('start-btn');
      const startScreen = document.getElementById('start-screen');
      const quizScreen = document.getElementById('quiz-screen');

      startBtn.addEventListener('click', () => {
        startScreen.classList.add('hidden');
        quizScreen.classList.remove('hidden');
        showQuestion();
      });

      function showQuestion() {
        const q = questions[currentIndex];
        document.getElementById('progress-text').innerText = `第 ${currentIndex + 1} / ${questions.length} 题`;
        document.getElementById('question-text').innerText = q.question;

        const container = document.getElementById('options-container');
        container.innerHTML = '';

        q.options.forEach(opt => {
          const btn = document.createElement('button');
          btn.className = 'option-btn';
          btn.innerText = opt.text;
          btn.onclick = () => selectOption(opt.dimension);
          container.appendChild(btn);
        });
      }

      function selectOption(dim) {
        userAnswers.push(dim);
        currentIndex++;

        if (currentIndex < questions.length) {
          showQuestion();
        } else {
          showResult();
        }
      }

      function showResult() {
        const counts = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 };
        userAnswers.forEach(d => counts[d]++);

        const mbti = [
          counts.E >= counts.I ? 'E' : 'I',
          counts.S >= counts.N ? 'S' : 'N',
          counts.T >= counts.F ? 'T' : 'F',
          counts.J >= counts.P ? 'J' : 'P'
        ].join('');

        window.location.href = `/result?type=${mbti}`;
      }
    </script>
  </body>
</html>
