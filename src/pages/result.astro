---
// 1. 定义 16 种性格的简易描述（也可以抽离成 json）
const mbtiMap: Record<string, { title: string; desc: string }> = {
  "INTJ": { title: "🦉 深谋远虑的夜鹰学者", desc: "你拥有极强的逻辑与独立思考能力，总是能规划好每一步行动。" },
  "INTP": { title: "🧪 奇思妙想的魔药大师", desc: "你喜欢探究万物背后的道理，脑子里装满了新奇的创意与原理。" },
  "ENTJ": { title: "🦁 勇敢无畏的狮心指挥官", desc: "你天生具有领导力，遇到困难时总能果断带领团队冲锋陷阵。" },
  "ENTP": { title: "🦊 灵动机智的幻术解密者", desc: "你反应迅速、思维敏捷，最喜欢发现新玩法和打破常规。" },
  "INFJ": { title: "🔮 洞察人心的小预言家", desc: "你内心细腻温暖，总能敏锐地感受到别人的情绪并给予关怀。" },
  "INFP": { title: "🦄 浪漫温和的独角兽守护者", desc: "你富有同理心与想象力，珍视美好的情感与心中的理想。" },
  "ENFJ": { title: "☀️ 温暖照耀的光明吟游诗人", desc: "你充满热情，善于鼓励大家，是伙伴们最信赖和喜爱的聚心骨。" },
  "ENFP": { title: "✨ 璀璨闪耀的星空创客", desc: "你对世界充满好奇与热忱，能把无限的灵感变成快乐的源泉。" },
  "ISTJ": { title: "🛡️ 恪守规则的秩序骑士", desc: "你踏实可靠、做事细心，答应好的事情一定会认真负责到底。" },
  "ISFJ": { title: "🌿 守护自然的森林大白熊", desc: "你默默奉献、温和体贴，总是细心照顾身边的每一个人。" },
  "ESTJ": { title: "📜 公正严明的法术纪检官", desc: "你条理清晰、效率极高，最擅长把复杂的事情安排得井井有条。" },
  "ESFJ": { title: "🏰 热情好客的城堡大管家", desc: "你擅长交际且充满爱心，总是能让大家在一个融洽的环境里相处。" },
  "ISTP": { title: "🛠️ 灵活敏捷的符文匠人", desc: "你动手能力极强，面对突发状况冷静沉着，能快速解决实际问题。" },
  "ISFP": { title: "🎨 灵动自由的自然艺术家", desc: "你用独特的眼光观察世界，喜欢用各种方式表达美与感受。" },
  "ESTP": { title: "🦅 追风逐浪的飞天扫帚手", desc: "你行动力满分，热爱冒险与挑战，在实战中表现极其出色。" },
  "ESFP": { title: "🎭 极具魅力的魔法舞台明星", desc: "你充满活力与幽默感，无论走到哪里都能带来欢声笑语。" }
};
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>魔法分院卡片</title>
    <style>
      body { font-family: sans-serif; max-width: 500px; margin: 50px auto; padding: 0 20px; text-align: center; background: #0f172a; color: #fff; }
      .card { border: 2px solid #38bdf8; border-radius: 16px; padding: 30px; background: #1e293b; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
      .type-code { font-size: 1.2rem; color: #38bdf8; font-weight: bold; }
      .title { font-size: 1.8rem; margin: 15px 0; color: #fbbf24; }
      .desc { font-size: 1rem; line-height: 1.6; color: #cbd5e1; }
      .btn { display: inline-block; margin-top: 25px; padding: 10px 20px; background: #38bdf8; color: #0f172a; border-radius: 8px; text-decoration: none; font-weight: bold; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="type-code" id="mbti-code">检测中...</div>
      <h1 class="title" id="mbti-title"></h1>
      <p class="desc" id="mbti-desc"></p>
    </div>

    <a href="/" class="btn">重新测试</a>

    <script define:vars={{ mbtiMap }}>
      // 从 URL 的 Query 参数获取 MBTI 类型 (例如 /result?type=ENFP)
      const urlParams = new URLSearchParams(window.location.search);
      const type = (urlParams.get('type') || 'ENFP').toUpperCase();

      const info = mbtiMap[type] || mbtiMap['ENFP'];

      document.getElementById('mbti-code').innerText = `[ ${type} ]`;
      document.getElementById('mbti-title').innerText = info.title;
      document.getElementById('mbti-desc').innerText = info.desc;
    </script>
  </body>
</html>
